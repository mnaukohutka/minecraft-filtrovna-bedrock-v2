### **4.1 PRAXY ZA FILTR PRO FILTR **

// Animation and plotting for dropping items
function dropAnimation(itemId, slotId, renderer) {
  const items = this.items;
  const map = this.map;
  const block = this.block;

  // Move items to their slot
  items.sort((a, b) => a.id - b.id).forEach(item => {
    block.add(item.id, slotId);
    renderer.add(item, { x: item.x, y: item.y });
  });

  // Animate moving items
  renderer.animate({
    interval: this.interval, 
    start: 0,
    items: items,
    itemId: itemId,
    slotId: slotId
  });
}

// Collision detection
function collided(a, b) {
  const map = this.map;
  return map.collision(a, b);
}

