def filter(itemId, slotId, renderer, bedrockFilters):
    if itemId not in itemsToMove:
        itemsToMove.append(itemId)
    renderer.add(itemId, {
        position: {
            x: 0,
            z: 0
        }
    })

def animate(items, interval, renderer, bedrockFilters):
    items.sort()
    while items:
        items = items[:len(itemsToMove)]
        for i, itemId in enumerate(itemsToMove):
            renderer.animate({
                interval,
                start,
                items,
                itemId,
                slotId
            })
            itemsToMove[i] = None

items = [1]
itemsToMove = []
renderer = createRenderer(items)
