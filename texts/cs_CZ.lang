### **5.3 PRAXY ZA FILTR ZA FILTR (VYHODNěNÉ KODOVY POJEDNÁVANOS)**

// Simple filter implementation
function filter(itemId, slotId, renderer) {
  const items = this.items;
  const map = this.map;

  if (itemId === this.item_id) {
    renderer.add(itemId, {
      position: {
        x: 0,
        z: 0
      }
    });
  }

  // Simple movement check
  renderer.animate({
    interval: this.interval,
    start: 0,
    items: items,
    itemId: this.item_id,
    slotId: slotId
  });
}

