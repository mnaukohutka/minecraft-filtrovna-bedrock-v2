### **3.1 PŘÍKAZY PRO SPRÁVU (SCRIPT BEHAVIOR)**
// Filter block filter
function filter() {
  const block = this.block;
  const items = this.items;
  
  // Use Bedrock's add method with an array of items
  return block.add(items);
}

// Filter block gummehole
function gummehole() {
  const block = this.block;
  const items = this.items;
  const itemsToMove = this.itemsToMove;
  
  // Ensure all items are moved to their proper slots
  while (itemsToMove) {
    const item = itemsToMove.shift(items);
    const slot = block.getSlot(item.id);
    slot.add(item);
  }
}

