{
  "format_version": "1.10.0",
  "animation_controllers": [
    {
      "controller.filtrovna.golem_inside": {
        "initial_state": "default",
        "states": {
          "default": {
            "transitions": [
              {
                "inspect": "q.is_inspecting == 1"
              },
              {
                "process": "q.is_processing == 1"
              },
              {
                "stuck": "q.is_stuck == 1"
              }
            ]
          },
          "inspect": {
            "on_entry": [
              "/play animation.filtrovna.golem_inside.inspect"
            ],
            "transitions": [
              {
                "default": "!q.is_inspecting"
              }
            ]
          },
          "process": {
            "on_entry": [
              "/play animation.filtrovna.golem_inside.process"
            ],
            "transitions": [
              {
                "default": "!q.is_processing"
              }
            ]
          },
          "stuck": {
            "on_entry": [
              "/play animation.filtrovna.golem_inside.stuck"
            ],
            "transitions": [
              {
                "default": "!q.is_stuck"
              }
            ]
          }
        }
      }
    }
  ]
}
